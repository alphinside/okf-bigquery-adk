# Copy to .env and fill in. Never commit .env.

# Your Google Cloud project. Enable the BigQuery API on it. That step alone turns
# on the BigQuery MCP server that the agent sends its queries to.
GOOGLE_CLOUD_PROJECT=your-project-id

# Model access through Gemini Enterprise Agent Platform. This uses the same
# Application Default Credentials that the BigQuery MCP server needs, so you set
# up one credential instead of two.
# The name GOOGLE_GENAI_USE_VERTEXAI keeps its old spelling. Do not change it.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Instead of the three lines that precede this, you can use a Gemini API key from
# ai.google.dev. You still need Application Default Credentials for BigQuery.
# GEMINI_API_KEY=

# The OKF bundle that the agent reads. The default is bundles/marketplace. Set it
# to bundles/generated to see the same agent answer without the hand-written
# concept documents.
# OKF_BUNDLE=bundles/marketplace

# Set this only when a different project pays for your BigQuery queries.
# PROJECT_ID=
